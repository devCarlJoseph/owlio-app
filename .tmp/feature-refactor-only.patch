diff --git a/src/context/theme-provider.tsx b/src/context/theme-provider.tsx
new file mode 100644
index 0000000..49b9a9b
--- /dev/null
+++ b/src/context/theme-provider.tsx
@@ -0,0 +1,13 @@
+import { useEffect, useMemo, useSyncExternalStore, type ReactNode } from 'react'
+import { getTheme, setTheme, subscribeTheme, watchTheme } from '@/lib/theme'
+import { ThemeContext } from './theme-context'
+
+const getServerTheme = () => 'system' as const
+
+export function ThemeProvider({ children }: { children: ReactNode }) {
+  const theme = useSyncExternalStore(subscribeTheme, getTheme, getServerTheme)
+  useEffect(watchTheme, [])
+  const value = useMemo(() => ({ theme, setTheme }), [theme])
+
+  return <ThemeContext.Provider value={value}>{children}</ThemeContext.Provider>
+}
