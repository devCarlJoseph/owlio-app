VITE_API_URL=http://localhost:7000
# Public API origin only: do not append /api or /api/v1. Restart Vite after changing it.
# Use the same localhost/127.0.0.1 host consistently. owlio-api FRONTEND_URL must
# exactly match the frontend origin for credentialed CORS (default http://localhost:5173).
# Authentication uses HttpOnly cookies and CSRF. There is no browser API key.
# Brevo SMTP and Google OAuth secrets belong only in owlio-api/.env, never in VITE_* variables.
